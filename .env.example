# Core service
WEB_HOST=0.0.0.0
WEB_PORT=8020
LOG_LEVEL=INFO
DETERMINFLOW_DATA_DIR=./data
DETERMINFLOW_LOGS_DIR=./logs
DETERMINFLOW_CONFIG_DIR=./config

# ==================== 鉴权（登录）配置 ====================
# 默认启用：任何人访问都必须登录后才能使用项目。
# AUTH_ENABLED=false 可关闭鉴权（不推荐，仅本地调试）。
AUTH_ENABLED=true
# 登录账号（未配置时使用内置默认账号 admin / admin，启动日志会提醒修改）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
# 多用户时也可在 data/auth_users.json 中配置，格式见 README「鉴权与登录」章节。
# AUTH_USERS_FILE=./data/auth_users.json
# 签名密钥：不设置时自动生成并持久化到 data/.auth_secret（重启后 Token 仍有效）
# AUTH_SECRET=please-change-me
# Token 有效期（天）
AUTH_TOKEN_TTL_DAYS=7

# Keep only the newest terminal Workflow Session records. Interactive and
# recoverable sessions are never counted. Set to 0 to discard terminal history.
SESSION_HISTORY_MAX_ENTRIES=1000

# Model credential referenced by config/models_config.json.
DEEPSEEK_API_KEY=

# Optional: override config/extensions.json with comma-separated Plugin IDs.
# Use "none" only when you intentionally need a Core-only runtime.
# DETERMINFLOW_EXTENSIONS=none

# Optional browser and workspace settings
# CORS_ORIGINS=http://localhost:5173
# CORS_ALLOW_ALL=false
# CODING_WORKSPACE_COPY_ON_CREATE=true

# Community default: supervised local Workflow Executor Pool. Count applies
# only in process mode. Set mode to "inline" and count to 1 to fall back to
# the single-process path.
DETERMINFLOW_WORKFLOW_EXECUTOR_MODE=process
DETERMINFLOW_WORKFLOW_EXECUTOR_COUNT=4
